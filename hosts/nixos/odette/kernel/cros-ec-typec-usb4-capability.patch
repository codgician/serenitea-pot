platform/chrome: cros_ec_typec: Infer USB4 from USB3 mapping

Intel TCSS firmware describes USB4 tunneling on the USB3 port referenced by
a Type-C connector. The USB3 node carries usb4-host-interface and
usb4-port-number; existing firmware does not provide a separate
connector-level usb4-port reference.

Recognize that mapping when populating the host USB capability, provided
the referenced USB4 host interface is available, matching the check the
Type-C port mapper uses before linking the USB4 port. Keep supporting
usb4-port for firmware with a dedicated USB4 port object.

---
diff --git a/drivers/platform/chrome/cros_ec_typec.c b/drivers/platform/chrome/cros_ec_typec.c
--- a/drivers/platform/chrome/cros_ec_typec.c
+++ b/drivers/platform/chrome/cros_ec_typec.c
@@ -12,6 +12,7 @@
 #include <linux/platform_data/cros_ec_commands.h>
 #include <linux/platform_data/cros_usbpd_notify.h>
 #include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/usb/pd_vdo.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_tbt.h>
@@ -150,6 +151,24 @@ static const struct typec_operations cros_typec_usb_mode_ops = {
 	.pr_set = cros_typec_pr_swap,
 };
 
+/*
+ * Intel TCSS firmware describes USB4 tunneling on the connector's USB3 port
+ * rather than through a connector-level usb4-port reference.
+ */
+static bool cros_typec_usb3_port_has_usb4(struct fwnode_handle *fwnode)
+{
+	struct fwnode_handle *usb3 __free(fwnode_handle) =
+		fwnode_find_reference(fwnode, "usb3-port", 0);
+	struct fwnode_handle *nhi __free(fwnode_handle) = NULL;
+
+	if (IS_ERR(usb3))
+		return false;
+
+	nhi = fwnode_find_reference(usb3, "usb4-host-interface", 0);
+	return !IS_ERR(nhi) && fwnode_device_is_available(nhi) &&
+	       fwnode_property_present(usb3, "usb4-port-number");
+}
+
 static int cros_typec_parse_port_props(struct typec_capability *cap,
 				       struct fwnode_handle *fwnode,
 				       struct device *dev)
@@ -196,7 +215,8 @@ static int cros_typec_parse_port_props(struct typec_capability *cap,
 		cap->usb_capability |= USB_CAPABILITY_USB2;
 	if (fwnode_property_present(fwnode, "usb3-port"))
 		cap->usb_capability |= USB_CAPABILITY_USB3;
-	if (fwnode_property_present(fwnode, "usb4-port"))
+	if (fwnode_property_present(fwnode, "usb4-port") ||
+	    cros_typec_usb3_port_has_usb4(fwnode))
 		cap->usb_capability |= USB_CAPABILITY_USB4;
 
 	cros_typec_role_switch_quirk(fwnode);
-- 
2.54.0
