platform/chrome: cros_ec_typec: Confirm USB4 entry from mux state

The EC accepts an Enter USB4 request while DisplayPort or Thunderbolt mode
is active, returns success, and keeps the existing mode. It also drops the
request silently when the cable cannot carry USB4. In both cases the
partner is left without USB4 and without alternate-mode selection.

Exit any active high-speed mode first, then request USB4, and advance each
step from the serialized port update when the EC reports the mux change.
Set the partner USB mode only once the mux shows USB4. A freezable delayed
work item only wakes the port update at the timeout boundary; on timeout
or command failure, fall back to alternate-mode selection.

---
diff --git a/drivers/platform/chrome/cros_ec_typec.c b/drivers/platform/chrome/cros_ec_typec.c
--- a/drivers/platform/chrome/cros_ec_typec.c
+++ b/drivers/platform/chrome/cros_ec_typec.c
@@ -358,11 +358,78 @@ static int cros_typec_usb_disconnect_state(struct cros_typec_port *port)
 	return typec_mux_set(port->mux, &port->state);
 }
 
+#define CROS_TYPEC_MUX_HS_MODES	(USB_PD_MUX_USB4_ENABLED | USB_PD_MUX_DP_ENABLED | \
+				 USB_PD_MUX_TBT_COMPAT_ENABLED)
+
+static void cros_typec_start_mode_selection(struct cros_typec_port *port)
+{
+	if (typec_mode_selection_start(port->partner, MODE_SELECTION_DELAY,
+				       MODE_SELECTION_TIMEOUT) < 0)
+		dev_warn(port->typec_data->dev,
+			 "Unable to run mode selection, port: %d\n", port->port_num);
+}
+
+/*
+ * The EC accepts USB4 entry requests without acting on them while another
+ * mode is active, and may also drop them silently. Exit any high-speed mode
+ * first, then confirm each step from the mux state reported by the EC.
+ */
+static void cros_typec_request_usb_mode(struct cros_typec_port *port,
+					enum usb_mode mode)
+{
+	int ret = cros_typec_enter_usb_mode(port->port, mode);
+
+	if (ret < 0) {
+		port->usb_mode_req = USB_MODE_NONE;
+		dev_warn(port->typec_data->dev,
+			 "Unable to activate USB4 mode, port: %d, err = %d\n",
+			 port->port_num, ret);
+		cros_typec_start_mode_selection(port);
+		return;
+	}
+
+	port->usb_mode_req = mode;
+	mod_delayed_work(system_freezable_wq, &port->usb_mode_timeout,
+			 msecs_to_jiffies(MODE_SELECTION_TIMEOUT));
+}
+
+static void cros_typec_update_usb_mode(struct cros_typec_port *port)
+{
+	if (!port->partner || port->usb_mode_req == USB_MODE_NONE)
+		return;
+
+	if (port->usb_mode_req == USB_MODE_USB3 &&
+	    !(port->mux_flags & CROS_TYPEC_MUX_HS_MODES)) {
+		cros_typec_request_usb_mode(port, USB_MODE_USB4);
+	} else if (port->usb_mode_req == USB_MODE_USB4 &&
+		   (port->mux_flags & USB_PD_MUX_USB4_ENABLED)) {
+		port->usb_mode_req = USB_MODE_NONE;
+		cancel_delayed_work(&port->usb_mode_timeout);
+		typec_partner_set_usb_mode(port->partner, USB_MODE_USB4);
+	} else if (!delayed_work_pending(&port->usb_mode_timeout)) {
+		port->usb_mode_req = USB_MODE_NONE;
+		dev_warn(port->typec_data->dev,
+			 "USB4 mode transition timed out, port: %d\n", port->port_num);
+		cros_typec_start_mode_selection(port);
+	}
+}
+
+static void cros_typec_usb_mode_timeout(struct work_struct *work)
+{
+	struct cros_typec_port *port = container_of(to_delayed_work(work),
+						    struct cros_typec_port,
+						    usb_mode_timeout);
+
+	schedule_work(&port->typec_data->port_work);
+}
+
 static void cros_typec_remove_partner(struct cros_typec_data *typec,
 				      int port_num)
 {
 	struct cros_typec_port *port = typec->ports[port_num];
 
+	port->usb_mode_req = USB_MODE_NONE;
+	cancel_delayed_work_sync(&port->usb_mode_timeout);
 	if (!port->partner)
 		return;
 
@@ -529,6 +596,8 @@ static int cros_typec_init_ports(struct cros_typec_data *typec)
 		cros_port->port_num = port_num;
 		cros_port->typec_data = typec;
 		typec->ports[port_num] = cros_port;
+		INIT_DELAYED_WORK(&cros_port->usb_mode_timeout,
+				  cros_typec_usb_mode_timeout);
 		cap = &cros_port->caps;
 
 		ret = cros_typec_parse_port_props(cap, fwnode, dev);
@@ -1001,22 +1070,12 @@ static int cros_typec_register_altmodes(struct cros_typec_data *typec, int port_
 		bool usb4_mode = (port->caps.usb_capability & USB_CAPABILITY_USB4) &&
 			(PD_VDO_UFP_DEVCAP(port->p_identity.vdo[0]) & DEV_USB4_CAPABLE);
 
-		if (usb4_mode) {
-			ret = cros_typec_enter_usb_mode(port->port, USB_MODE_USB4);
-			if (ret < 0) {
-				usb4_mode = false;
-				dev_warn(typec->dev,
-					 "Unable to activate USB4 mode, port: %d\n", port_num);
-			}
-		}
-		if (!usb4_mode) {
-			ret = typec_mode_selection_start(port->partner,
-							 MODE_SELECTION_DELAY,
-							 MODE_SELECTION_TIMEOUT);
-			if (ret < 0)
-				dev_warn(typec->dev,
-					 "Unable to run mode selection, port: %d\n", port_num);
-		}
+		if (!usb4_mode)
+			cros_typec_start_mode_selection(port);
+		else if (port->mux_flags & CROS_TYPEC_MUX_HS_MODES)
+			cros_typec_request_usb_mode(port, USB_MODE_USB3);
+		else
+			cros_typec_request_usb_mode(port, USB_MODE_USB4);
 	}
 
 	return 0;
@@ -1357,6 +1416,8 @@ static int cros_typec_port_update(struct cros_typec_data *typec, int port_num)
 	if (typec->typec_cmd_supported)
 		cros_typec_handle_status(typec, port_num);
 
+	cros_typec_update_usb_mode(typec->ports[port_num]);
+
 	return 0;
 }
 
@@ -1498,8 +1559,13 @@ static int cros_typec_probe(struct platform_device *pdev)
 static void cros_typec_remove(struct platform_device *pdev)
 {
 	struct cros_typec_data *typec = platform_get_drvdata(pdev);
+	int i;
 
 	cros_usbpd_unregister_notify(&typec->nb);
+	/* The timeout requeues port_work, so stop it first. */
+	for (i = 0; i < typec->num_ports; i++)
+		if (typec->ports[i])
+			disable_delayed_work_sync(&typec->ports[i]->usb_mode_timeout);
 	cancel_work_sync(&typec->port_work);
 	cros_unregister_ports(typec);
 }
diff --git a/drivers/platform/chrome/cros_ec_typec.h b/drivers/platform/chrome/cros_ec_typec.h
--- a/drivers/platform/chrome/cros_ec_typec.h
+++ b/drivers/platform/chrome/cros_ec_typec.h
@@ -66,6 +66,9 @@ struct cros_typec_port {
 	struct typec_mux_state state;
 	uint8_t mux_flags;
 	uint8_t role;
+	/* USB mode requested from the EC and not yet reflected in mux_flags. */
+	enum usb_mode usb_mode_req;
+	struct delayed_work usb_mode_timeout;
 
 	struct typec_altmode *port_altmode[CROS_EC_ALTMODE_MAX];
 
-- 
2.54.0
