<?xml version="1.0"?>
<ThermalConfiguration>
  <Platform>
    <Name>HP Elite Dragonfly Chromebook</Name>
    <ProductName>*</ProductName>
    <Preference>QUIET</Preference>
    <!--
      No PPCC block: the RAPL long-term (PL1) power limit baseline is set
      directly via powercap sysfs by rapl-power-limit-select (AC/battery
      dependent), not by thermald. thermald here handles only the passive
      thermal trips below, stepping the already-set PL1 down further via
      rapl_controller if a sensor crosses its threshold, and restoring it on
      cooldown. This applies identically regardless of AC/battery state.
    -->
    <ThermalZones>
      <ThermalZone>
        <Type>TCPU</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>TCPU</SensorType>
            <Temperature>80000</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>rapl_controller</type>
              <influence>100</influence>
              <SamplingPeriod>5</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
      <ThermalZone>
        <Type>TSR0</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>TSR0</SensorType>
            <Temperature>70000</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>rapl_controller</type>
              <influence>100</influence>
              <SamplingPeriod>5</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
      <ThermalZone>
        <Type>TSR1</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>TSR1</SensorType>
            <Temperature>70000</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>rapl_controller</type>
              <influence>100</influence>
              <SamplingPeriod>5</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
      <ThermalZone>
        <Type>TSR2</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>TSR2</SensorType>
            <Temperature>75000</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>TCHG</type>
              <influence>100</influence>
              <SamplingPeriod>5</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
      <ThermalZone>
        <Type>TSR3</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>TSR3</SensorType>
            <Temperature>75000</Temperature>
            <type>passive</type>
            <ControlType>SEQUENTIAL</ControlType>
            <CoolingDevice>
              <type>rapl_controller</type>
              <influence>100</influence>
              <SamplingPeriod>5</SamplingPeriod>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
    </ThermalZones>
  </Platform>
</ThermalConfiguration>
