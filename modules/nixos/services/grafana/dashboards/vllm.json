      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_requests_total{job=\"vllm\",instance=~\"$instance\",handler=~\"$handler\",status=\"5xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"vllm\",instance=~\"$instance\",handler=~\"$handler\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "legendFormat": "5xx",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_requests_total{job=\"vllm\",instance=~\"$instance\",handler=~\"$handler\",status=\"4xx\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"vllm\",instance=~\"$instance\",handler=~\"$handler\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "legendFormat": "4xx",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "HTTP error ratios",
      "type": "stat"
    },
