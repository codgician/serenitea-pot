# Subject: Order ALSA adapter suspension and reset live graphs in place
# Upstream-Status: Pending (local 1.6.6 changes; no upstream submission tracked)
# Base: PipeWire 1.6.6
# Depends-On: pipewire-graph-snapshot-backport.patch
# Regression: check-pipewire-graphs.py active Suspend/Start, Flush and reopening.
# Drop-When: upstream quiesces the callback-owning follower before teardown, resets
# live Flush without tearing down handles, and handles stopped callbacks equivalently.
# Keep separate from the upstream-derived snapshot fix; this is not a pure backport.
diff --git a/spa/plugins/audioconvert/audioconvert.c b/spa/plugins/audioconvert/audioconvert.c
--- a/spa/plugins/audioconvert/audioconvert.c
+++ b/spa/plugins/audioconvert/audioconvert.c
@@ -2577,2 +2600,29 @@
 
+static int do_flush_node(struct spa_loop *loop, bool async, uint32_t seq,
+		const void *data, size_t size, void *user_data)
+{
+	struct impl *this = user_data;
+	struct filter_graph *g;
+	int res;
+
+	spa_list_for_each(g, &this->active_graphs, link) {
+		if (!g->setup || g->removing || g->graph == NULL)
+			continue;
+		if ((res = spa_filter_graph_reset(g->graph)) < 0)
+			return res;
+	}
+	if (this->resample.reset)
+		resample_reset(&this->resample);
+	this->in_offset = 0;
+	this->out_offset = 0;
+	return 0;
+}
+
+static int flush_node(struct impl *this)
+{
+	if (this->data_loop)
+		return spa_loop_locked(this->data_loop, do_flush_node, 0, NULL, 0, this);
+	return do_flush_node(NULL, false, 0, NULL, 0, this);
+}
+
 static int impl_node_send_command(void *object, const struct spa_command *command)
@@ -2594,4 +2644,5 @@
 	case SPA_NODE_COMMAND_Suspend:
+		this->started = false;
 		reset_node(this);
-		SPA_FALLTHROUGH;
+		break;
 	case SPA_NODE_COMMAND_Pause:
@@ -2600,4 +2651,3 @@
 	case SPA_NODE_COMMAND_Flush:
-		reset_node(this);
-		break;
+		return flush_node(this);
 	default:
@@ -3823,2 +3873,5 @@
 
+	if (SPA_UNLIKELY(!this->started))
+		return SPA_STATUS_OK;
+
 	/* calculate quantum scale, this is how many samples we need to produce or
diff --git a/spa/plugins/audioconvert/audioadapter.c b/spa/plugins/audioconvert/audioadapter.c
--- a/spa/plugins/audioconvert/audioadapter.c
+++ b/spa/plugins/audioconvert/audioadapter.c
@@ -1086,2 +1086,3 @@
 	case SPA_NODE_COMMAND_Suspend:
+		this->ready = false;
 		spa_log_debug(this->log, "%p: suspending", this);
@@ -1099,17 +1100,41 @@
 
-	res = spa_node_send_command(this->target, command);
-	if (res == -ENOTSUP && this->target != this->follower)
-		res = 0;
-	if (res < 0) {
-		spa_log_error(this->log, "%p: can't send command %d: %s",
-				this, SPA_NODE_COMMAND_ID(command),
-				spa_strerror(res));
-	}
+	if (SPA_NODE_COMMAND_ID(command) == SPA_NODE_COMMAND_Suspend &&
+	    this->target != this->follower) {
+		int follower_res;
 
-	if (res >= 0 && this->target != this->follower) {
-		if ((res = spa_node_send_command(this->follower, command)) < 0) {
+		/* The follower owns the data-loop callback; stop it before target teardown. */
+		follower_res = spa_node_send_command(this->follower, command);
+		if (follower_res < 0) {
 			spa_log_error(this->log, "%p: can't send command %d: %s",
 					this, SPA_NODE_COMMAND_ID(command),
+					spa_strerror(follower_res));
+		}
+
+		res = spa_node_send_command(this->target, command);
+		if (res == -ENOTSUP)
+			res = 0;
+		if (res < 0) {
