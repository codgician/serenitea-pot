# Subject: Restore requested graph volume and mute before graph activation
# Upstream-Status: Pending (local fix; no upstream submission tracked)
# Base: PipeWire 1.6.6, after pipewire-graph-lifecycle.patch
# Regression: check-pipewire-graphs.py default initialization, saved gain/mute and stereo balance.
# Drop-When: upstream retains requested volume independently of the locked software mixer and
# applies it before activation, including unchanged defaults and graph/format recreation.
diff --git a/spa/plugins/audioconvert/audioconvert.c b/spa/plugins/audioconvert/audioconvert.c
--- a/spa/plugins/audioconvert/audioconvert.c
+++ b/spa/plugins/audioconvert/audioconvert.c
@@ -283,6 +283,7 @@ struct impl {
 	struct spa_ratelimit rate_limit;
 
 	struct props props;
+	struct volumes graph_volume;
 
 	struct spa_io_clock *io_clock;
 	struct spa_io_position *io_position;
@@ -1186,6 +1187,10 @@ static int setup_filter_graph(struct impl *this, struct filter_graph *g,
 	int res;
 	char rate_str[64], in_ports[64];
 	struct dir *dir;
+	uint8_t buffer[1024];
+	struct spa_pod_builder b;
+	struct spa_pod *param;
+	uint32_t n_volumes;
 
 	if (g->graph == NULL || g->setup)
 		return 0;
@@ -1201,6 +1206,21 @@ static int setup_filter_graph(struct impl *this, struct filter_graph *g,
 	}
 
 	spa_filter_graph_deactivate(g->graph);
+	n_volumes = this->graph_volume.n_volumes;
+	if (n_volumes == 0)
+		n_volumes = SPA_MIN(channels, SPA_N_ELEMENTS(this->graph_volume.volumes));
+	if (n_volumes > 0) {
+		spa_pod_builder_init(&b, buffer, sizeof(buffer));
+		param = spa_pod_builder_add_object(&b,
+				SPA_TYPE_OBJECT_Props, SPA_PARAM_Props,
+				SPA_PROP_mute, SPA_POD_Bool(this->graph_volume.mute),
+				SPA_PROP_channelVolumes, SPA_POD_Array(sizeof(float),
+						SPA_TYPE_Float, n_volumes, this->graph_volume.volumes));
+		if (param == NULL)
+			return -ENOSPC;
+		if ((res = spa_filter_graph_set_props(g->graph, SPA_DIRECTION_INPUT, param)) < 0)
+			return res;
+	}
 	res = spa_filter_graph_activate(g->graph,
 				     &SPA_DICT_ITEMS(
 					     SPA_DICT_ITEM(SPA_KEY_AUDIO_RATE, rate_str),
@@ -1998,7 +2018,33 @@ static int node_set_param_port_config(struct impl *this, uint32_t flags,
 	return reconfigure_mode(this, mode, direction, monitor, control, infop);
 }
 
+static void cache_filter_graph_volume(struct impl *this, const struct spa_pod *param)
+{
+	struct spa_pod_prop *prop;
+	struct spa_pod_object *obj = (struct spa_pod_object *) param;
+	struct volumes *vol = &this->graph_volume;
+	uint32_t n;
+
+	if (!spa_pod_is_object_type(param, SPA_TYPE_OBJECT_Props))
+		return;
+
+	SPA_POD_OBJECT_FOREACH(obj, prop) {
+		switch (prop->key) {
+		case SPA_PROP_mute:
+			spa_pod_get_bool(&prop->value, &vol->mute);
+			break;
+		case SPA_PROP_channelVolumes:
+			if ((n = spa_pod_copy_array(&prop->value, SPA_TYPE_Float,
+					vol->volumes, SPA_N_ELEMENTS(vol->volumes))) > 0)
+				vol->n_volumes = n;
+			break;
+		default:
+			break;
+		}
+	}
+}
+
 static int node_set_param_props(struct impl *this, uint32_t flags,
 				const struct spa_pod *param)
 {
 	bool have_graph = false;
@@ -2007,6 +2053,7 @@ static int node_set_param_props(struct impl *this, uint32_t flags,
 	if (param == NULL)
 		return 0;
 
+	cache_filter_graph_volume(this, param);
 	this->filter_props_count = 0;
 
 	spa_list_for_each_safe(g, t, &this->active_graphs, link) {
@@ -4292,6 +4339,7 @@ impl_init(const struct spa_handle_factory *factory,
 	this->loader = spa_support_find(support, n_support, SPA_TYPE_INTERFACE_PluginLoader);
 
 	props_reset(&this->props);
+	init_volumes(&this->graph_volume);
 	filter_graph_disabled = this->props.filter_graph_disabled;
 	spa_list_init(&this->active_graphs);
 	spa_list_init(&this->free_graphs);
