# Subject: Reject explicitly configured graphs instead of silently bypassing DSP
# Upstream-Status: Pending (local failure policy and init-error propagation; not submitted)
# Base: PipeWire 1.6.6; first patch in the Redrix series
# Regression: check-pipewire-graphs.py missing-plugin node rejection with a valid control node.
# Drop-When: upstream provides equivalent fail-closed graph loading/activation and propagates
# converter initialization errors. A policy knob must be enabled before removing this patch.
diff --git a/spa/plugins/audioconvert/audioconvert.c b/spa/plugins/audioconvert/audioconvert.c
--- a/spa/plugins/audioconvert/audioconvert.c
+++ b/spa/plugins/audioconvert/audioconvert.c
@@ -1311,9 +1311,9 @@ static int setup_filter_graphs(struct impl *impl, bool force)
 		if (force)
 			g->setup = false;
 		if ((res = setup_filter_graph(impl, g, channels, position)) < 0) {
-			g->removing = true;
 			spa_log_warn(impl->log, "failed to activate graph %d: %s", g->order,
 					spa_strerror(res));
+			return res;
 		} else {
 			channels = g->n_outputs;
 			position = g->outputs_position;
@@ -1517,6 +1517,7 @@ static int audioconvert_set_param(struct impl *this, const char *k,
 		if ((res = load_filter_graph(this, s, order)) < 0) {
 			spa_log_warn(this->log, "Can't load filter-graph %d: %s",
 					order, spa_strerror(res));
+			return res;
 		}
 	}
 	else
@@ -4390,7 +4391,11 @@ impl_init(const struct spa_handle_factory *factory,
 	for (i = 0; info && i < info->n_items; i++) {
 		const char *k = info->items[i].key;
 		const char *s = info->items[i].value;
-		audioconvert_set_param(this, k, s, &filter_graph_disabled);
+		int res = audioconvert_set_param(this, k, s, &filter_graph_disabled);
+		if (res < 0) {
+			impl_clear(handle);
+			return res;
+		}
 	}
 	this->props.filter_graph_disabled = filter_graph_disabled;
 
diff --git a/spa/plugins/audioconvert/audioadapter.c b/spa/plugins/audioconvert/audioadapter.c
--- a/spa/plugins/audioconvert/audioadapter.c
+++ b/spa/plugins/audioconvert/audioadapter.c
@@ -1961,8 +1961,12 @@ static int load_converter(struct impl *this, const struct spa_dict *info,
 		if (hnd_convert == NULL)
 			return -errno;
 
-		spa_handle_factory_init(&spa_audioconvert_factory,
+		int res = spa_handle_factory_init(&spa_audioconvert_factory,
 				hnd_convert, &cinfo, support, n_support);
+		if (res < 0) {
+			free(hnd_convert);
+			return res;
+		}
 	} else if (this->ploader) {
 		hnd_convert = spa_plugin_loader_load(this->ploader, factory_name, &cinfo);
 		if (!hnd_convert)
