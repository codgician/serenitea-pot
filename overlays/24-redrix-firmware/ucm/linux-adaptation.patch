+# Keep the reference's four-channel S32_LE hardware PCM, selecting channels
+# 0 and 1 without mixing or gain. Avoid ACP's implicit SplitPCM node pair.
+LibraryConfig.mic.SubstiConfig.pcm.redrix_mic {
+    type route
+    slave {
+        pcm "hw:${CardId},99"
+        channels 4
+        format S32_LE
+    }
+    ttable.0.0 1.0
+    ttable.1.1 1.0
 }
 
