+
+# ChromeOS Headphone -> ALSA's standard Headphones device identifier.
+# JackControl replaces CRAS's JackDev/JackSwitch event-device mapping.
+SectionDevice."Headphones" {
+    Comment "Headphones"
+    Value {
+        PlaybackPCM "hw:${CardId},1"
+        PlaybackChannels 2
+        PlaybackPriority 200
+        PlaybackMixerElem "DAC1"
+        JackControl "Headphone Jack"
+    }
+    EnableSequence [
+        cset "name='Headphone Jack Switch' on"
+        cset "name='Stereo1 DAC MIXL DAC L1 Switch' 1"
+        cset "name='Stereo1 DAC MIXR DAC R1 Switch' 1"
+    ]
+    DisableSequence [
+        cset "name='Headphone Jack Switch' off"
+        cset "name='Stereo1 DAC MIXL DAC L1 Switch' 0"
+        cset "name='Stereo1 DAC MIXR DAC R1 Switch' 0"
+    ]
+}
+
+# ChromeOS Internal Mic -> Mic1 for ALSA port classification and stable node ID.
+# CaptureChannelMap "0 0 -1 ..." selects PCM output 0 for both logical
+# channels; the redrix_mic route alias below captures that channel directly
+# and applies the CRAS-equivalent +20 dB software gain.
+SectionDevice."Mic1" {
+    Comment "Internal Microphone"
+    Value {
+        CapturePCM "redrix_mic"
+        CaptureChannels 1
+        CapturePriority 100
+        # Preserve the OEM CRAS metadata; the ttable gain below reproduces
+        # the +20 dB CRAS derives from it, not a reinterpretation as a UI knob.
+        IntrinsicSensitivity "-2600"
+    }
+    EnableSequence [
+        cset "name='RTNR10.0 rtnr_enable_10' @noiseReduction@"
+    ]
+    DisableSequence [
+        cset "name='RTNR10.0 rtnr_enable_10' off"
+    ]
+}
+
+# Plain alsa-lib route alias: select the firmware's processed channel 0,
+# convert to the S16_LE format its Google RTC component requires, and apply
+# CRAS's own +20 dB software gain (DEFAULT_CAPTURE_VOLUME_DBFS -600 minus
+# IntrinsicSensitivity -2600, from cras_alsa_io.c / cras_system_state.h,
+# release-R151). This is a documented, standalone alsa-lib plugin: any ALSA
+# client opens the same finished 1-channel PCM identically. It intentionally
+# avoids UCM's CaptureChannel<N>/CaptureChannelPos<N> keys, which PipeWire's
+# ACP layer (alsa-ucm.c: ucm_get_split_channels) interprets as a request to
+# build its own SplitPCM node pair in WirePlumber's ALSA monitor
+# (monitors/alsa.lua) -- an internal mechanism, not documented UCM2 syntax.
+LibraryConfig.mic.SubstiConfig.pcm.redrix_mic {
+    type route
+    slave {
+        pcm "hw:${CardId},99"
+        channels 2
+        format S16_LE
+    }
+    ttable.0.0 10.0
+}
+
+# ChromeOS Mic -> Headset. Mainline exposes the routing switch below, not a
+# "Headset Mic" capture-volume element; applications retain software volume.
+SectionDevice."Headset" {
+    Comment "Headset Microphone"
+    Value {
+        CapturePCM "hw:${CardId},1"
+        CaptureChannels 2
+        CapturePriority 200
+        JackControl "Headset Mic Jack"
+    }
+    EnableSequence [
+        cset "name='Headset Mic Switch' on"
+    ]
+    DisableSequence [
+        cset "name='Headset Mic Switch' off"
+    ]
+}
+
+# Keep the OEM PCM 2..5 mapping, with ALSA's standard jack/IEC958 handling
+# and the existing Linux port priorities. No community Chromebook include.
+Include.hdmi.File "/codecs/hda/hdmi.conf"
+Macro [
+    { HDMI { Number 1 Device 2 Priority 200 } }
+    { HDMI { Number 2 Device 3 Priority 300 } }
+    { HDMI { Number 3 Device 4 Priority 400 } }
+    { HDMI { Number 4 Device 5 Priority 500 } }
+]
+
+# CRAS's named noise/echo modifiers are not understood by PipeWire ACP.
+# Instead, Mic1 applies the configured NR setting and HiFi initializes AEC off.
+# Do not assign a generic media role that could enable firmware AEC implicitly.
+
+# ChromeOS's Echo Reference (PCM 6) and SCO Line In/Out (PCM 7) are CRAS
+# internal/offload endpoints, not additional desktop microphones or speakers.
+# They remain accessible as hardware PCMs but are not advertised here.
