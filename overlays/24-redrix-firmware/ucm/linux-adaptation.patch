+# ChromeOS Internal Mic -> Mic1 for ALSA port classification and stable node ID.
+# The reference maps logical FL/FR to raw PCM99 channels 0/1.
+SectionDevice."Mic1" {
+    Comment "Internal Microphone"
+    Value {
+        CapturePCM "redrix_mic"
+        CaptureChannels 2
+        CapturePriority 100
+        # Preserve the OEM CRAS metadata for applications that read it.
+        IntrinsicSensitivity "-2600"
+    }
 }
 
